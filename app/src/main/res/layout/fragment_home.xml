<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_horizontal"
        android:paddingTop="@dimen/page_padding_vertical"
        android:paddingEnd="@dimen/page_padding_horizontal"
        android:paddingBottom="@dimen/space_24"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvCourseBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_unavailable"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_4"
            android:text="@string/home_class_badge"
            android:textAppearance="@style/TextAppearance.CourseApp.Label"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvHomeCourseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/home_course_title"
            android:textAppearance="@style/TextAppearance.CourseApp.ScreenTitle"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/tvHomeCourseDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/home_course_desc"
            android:textAppearance="@style/TextAppearance.CourseApp.Body"
            android:textColor="@color/secondary_text"
            android:lineSpacingExtra="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeroCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            style="@style/Widget.CourseApp.FeatureCard"
            app:cardBackgroundColor="@color/surface_tinted">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/icon_container_size"
                        android:layout_height="@dimen/icon_container_size"
                        android:background="@drawable/bg_number_badge">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_materi"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_progress_title"
                            android:textAppearance="@style/TextAppearance.CourseApp.CardTitle" />

                        <TextView
                            android:id="@+id/tvCourseMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/home_meta_topics"
                            android:textAppearance="@style/TextAppearance.CourseApp.Supporting" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContinueLearning"
                    style="@style/CustomRoundedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/home_continue_learning" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvSectionNavTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/home_section_nav_title"
            android:textAppearance="@style/TextAppearance.CourseApp.SectionTitle" />

        <TextView
            android:id="@+id/tvSectionNavDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/home_section_nav_desc"
            android:textAppearance="@style/TextAppearance.CourseApp.Supporting" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNavMateri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clickable="true"
            android:focusable="true"
            style="@style/Widget.CourseApp.Card"
            app:strokeColor="@color/accent_materi_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/accent_materi_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_16">

                <FrameLayout
                    android:layout_width="@dimen/icon_container_size"
                    android:layout_height="@dimen/icon_container_size"
                    android:background="@drawable/bg_number_badge">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_materi"
                        app:tint="@color/primary"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_8"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_nav_materi_title"
                        android:textAppearance="@style/TextAppearance.CourseApp.CardTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_nav_materi_desc"
                        android:textAppearance="@style/TextAppearance.CourseApp.Supporting" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/primary"
                    android:contentDescription="@null" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNavQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clickable="true"
            android:focusable="true"
            style="@style/Widget.CourseApp.Card"
            app:strokeColor="@color/accent_quiz_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/accent_quiz_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_16">

                <FrameLayout
                    android:layout_width="@dimen/icon_container_size"
                    android:layout_height="@dimen/icon_container_size"
                    android:background="@drawable/bg_number_badge">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_quiz"
                        app:tint="@color/secondary"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_8"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_nav_quiz_title"
                        android:textAppearance="@style/TextAppearance.CourseApp.CardTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_nav_quiz_desc"
                        android:textAppearance="@style/TextAppearance.CourseApp.Supporting" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/secondary"
                    android:contentDescription="@null" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_32"
            android:background="@color/border_subtle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_24">

            <TextView
                android:id="@+id/tvFooterBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_footer_brand"
                android:textAppearance="@style/TextAppearance.CourseApp.Supporting"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/tvFooterSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/home_footer_sub"
                android:textAppearance="@style/TextAppearance.CourseApp.Label"
                android:textColor="@color/muted_text" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
