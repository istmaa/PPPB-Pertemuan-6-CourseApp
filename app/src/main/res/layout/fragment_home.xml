<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_horizontal"
        android:paddingTop="@dimen/page_padding_vertical"
        android:paddingEnd="@dimen/page_padding_horizontal"
        android:paddingBottom="@dimen/space_24"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvHomeCourseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_course_title"
            android:textAppearance="@style/TextAppearance.CourseApp.ScreenTitle"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/tvHomeCourseDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/home_course_desc"
            android:textAppearance="@style/TextAppearance.CourseApp.Body"
            android:textColor="@color/secondary_text"
            android:lineSpacingExtra="4dp" />

        <ImageView
            android:id="@+id/ivHomeCourse"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="@dimen/space_20"
            android:contentDescription="@string/home_course_placeholder_alt"
            android:scaleType="centerCrop"
            android:src="@drawable/home_course" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeroCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:clickable="true"
            android:focusable="true"
            style="@style/Widget.CourseApp.Card"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/icon_container_size"
                        android:layout_height="@dimen/icon_container_size"
                        android:background="@drawable/bg_number_badge">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_materi"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_progress_title"
                            android:textAppearance="@style/TextAppearance.CourseApp.CardTitle" />

                        <TextView
                            android:id="@+id/tvCourseMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/home_meta_topics"
                            android:textAppearance="@style/TextAppearance.CourseApp.Supporting" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNavQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clickable="true"
            android:focusable="true"
            style="@style/Widget.CourseApp.Card"
            app:strokeColor="@color/accent_quiz_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/accent_quiz_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_16">

                <FrameLayout
                    android:layout_width="@dimen/icon_container_size"
                    android:layout_height="@dimen/icon_container_size"
                    android:background="@drawable/bg_number_badge">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_quiz"
                        app:tint="@color/secondary"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_8"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_nav_quiz_title"
                        android:textAppearance="@style/TextAppearance.CourseApp.CardTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/home_nav_quiz_desc"
                        android:textAppearance="@style/TextAppearance.CourseApp.Supporting" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
