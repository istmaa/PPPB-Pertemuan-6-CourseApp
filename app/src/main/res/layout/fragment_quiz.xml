<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_horizontal"
        android:paddingTop="@dimen/page_padding_vertical"
        android:paddingEnd="@dimen/page_padding_horizontal"
        android:paddingBottom="@dimen/space_24"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvQuizHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiz_header_title"
            android:textAppearance="@style/TextAppearance.CourseApp.ScreenTitle" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuizLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            style="@style/Widget.CourseApp.Card"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:contentDescription="@string/quiz_placeholder_alt"
                    android:scaleType="centerCrop"
                    android:src="@drawable/quiz_illustration" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/quiz_card_title"
                    android:textAppearance="@style/TextAppearance.CourseApp.CardTitle" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStartQuiz"
                    style="@style/CustomRoundedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="@dimen/space_8"
                    android:drawableTint="@color/white"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16"
                    android:text="@string/quiz_start_action" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
